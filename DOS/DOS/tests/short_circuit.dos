int hits = 0

function bump() {
    hits++
    return 1
}

bool a = false && bump()
bool b = true || bump()
int c = false ? bump() : 7

println("hits=" + string(hits))
println("a=" + string(a))
println("b=" + string(b))
println("c=" + string(c))

if hits == 0 {
    println("short-circuit: ok")
} else {
    return 1
}
