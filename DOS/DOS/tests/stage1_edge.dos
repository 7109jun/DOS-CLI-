function greet(string who) {
    println("Hello, " + who)
}

greet("DOS")

int x = 5
x += 2
x *= 3
if x == 21 {
    println("compound assignment: ok")
} else if x == 20 {
    println("compound assignment: wrong-branch")
} else {
    println("compound assignment: fail")
}

